{
  "name": "tab-organizer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wxt -b firefox",
    "build": "wxt build -b firefox",
    "zip": "wxt zip -b firefox",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "verify": "npm run typecheck && npm run lint && npm run test",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tldts": "7.4.9"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.5",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@wxt-dev/module-react": "1.2.2",
    "typescript": "7.0.2",
    "vitest": "4.1.10",
    "wxt": "0.20.27"
  }
}
